// मारवाड़ रसोई — Firestore के नियम (विक्रम जी Firebase कंसोल → Firestore → Rules में पूरा चिपकाएँ)
// v12 (16-11-2026): + tkaam (📋 हमारी टीम के काम — VBE मैनेजर से, हर साथी सिर्फ़ अपने), tkr (साथी का जवाब); नई भूमिका saathi (सिर्फ़ अपने काम, रसोई का कुछ नहीं)।
// v11 (15-11-2026): + cfav (बिना पासवर्ड: रेटिंग + पसंद), cname (ग्राहक का नाम-सुधार)। v9: + rlog (रिमाइंडर का हाल), cbook (ग्राहक-बही), talk (वॉकी-टॉकी), dev (फोन का हाल), cacc (ग्राहक-खाता)। v8: डायरेक्टर = पक्की (verified) ईमेल marwarrasoimr@gmail.com, या पुराना नंबर 9509553600 (मोबाइल + पिन)। लोकेशन सिर्फ़ डायरेक्टर देखे।
rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function owner() { return request.auth != null && (request.auth.token.email in ['9509553600@marwar-rasoi.app'] || (request.auth.token.email == 'marwarrasoimr@gmail.com' && request.auth.token.email_verified == true)); }
    function role() { return get(/databases/$(db)/documents/staff/$(request.auth.uid)).data.role; }
    function staff() { return request.auth != null && (owner() || (exists(/databases/$(db)/documents/staff/$(request.auth.uid)) && role() in ['owner', 'manager', 'waiter', 'kitchen'])); }
    function mgr() { return request.auth != null && (owner() || (exists(/databases/$(db)/documents/staff/$(request.auth.uid)) && role() in ['owner', 'manager'])); }
    function d() { return request.resource.data; }
    function istMin() { return math.floor(((request.time.toMillis() + 19800000) % 86400000) / 60000); }

    // ऑर्डर और टेबल की पुकार। ग्राहक: सिर्फ़ नया बना सके और अपना (id जानकर) पढ़ सके — सूची नहीं, बदलाव नहीं।
    match /orders/{id} {
      allow get: if true;
      allow list, update: if staff();
      allow create: if staff() || (
        d().status == 'new' && d().by == 'customer' && d().kind in ['order', 'call'] && d().type in ['table', 'parcel', 'delivery']
        && d().keys().hasOnly(['kind', 'call', 'type', 'table', 'items', 'total', 'note', 'by', 'name', 'phone', 'addr', 'ts', 'status', 'log'])
        && (d().kind == 'call' || (istMin() >= 480 && istMin() < 1350)) // ग्राहक का ऑर्डर सिर्फ़ सुबह 8:00 से रात 10:30 (भारत का समय); पानी/वेटर/बिल की पुकार हर समय
        && d().ts is int && d().ts > request.time.toMillis() - 300000 && d().ts < request.time.toMillis() + 300000
        && (!('call' in d()) || d().call in ['water', 'waiter', 'bill'])
        && (!('items' in d()) || (d().items is list && d().items.size() <= 40))
        && (!('note' in d()) || d().note.size() <= 200) && (!('addr' in d()) || d().addr.size() <= 100) && (!('name' in d()) || d().name.size() <= 60)
        && (!('table' in d()) || (d().table is int && d().table >= 0 && d().table <= 40))
      );
      allow delete: if false; // पुराना डेटा कभी न मिटे
    }
    // टीम: हर कोई अपना खाता "pending" बना सके; मैनेजर/वेटर सिर्फ़ मालिक बनाए।
    match /staff/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || owner());
      allow list: if owner();
      allow create: if request.auth != null && request.auth.uid == uid && (owner() || d().role == 'pending');
      allow update: if owner();
      allow delete: if false;
    }
    // 📦 स्टोर (आया/गया/माँग/गिनती-सुधार), सामान-सूची, 🪑 प्रॉपर्टी, ✅ चेकलिस्ट — सिर्फ़ टीम; मिटाना किसी को नहीं
    match /stock/{id} { allow read, create, update: if staff(); allow delete: if false; }
    match /sitems/{id} { allow read, create, update: if staff(); allow delete: if false; }
    match /assets/{id} { allow read, create, update: if staff(); allow delete: if false; }
    match /checks/{id} { allow read, create, update: if staff(); allow delete: if false; }
    match /conf/{id} { allow read, create, update: if staff(); allow delete: if false; }
    // 💰 उधारी — सिर्फ़ मालिक और मैनेजर
    match /udhar/{id} { allow read, create, update: if request.auth != null && (owner() || (exists(/databases/$(db)/documents/staff/$(request.auth.uid)) && role() in ['owner', 'manager'])); allow delete: if false; }
    // 👥 ग्राहकों का डेटा (TMBill से) और मालिक की टिप्पणी — मालिक + मैनेजर पढ़ें/संदेश भेजें; फ़ाइल सिर्फ़ मालिक चढ़ाए
    match /cust/{id} { allow read: if mgr(); allow create, update: if owner(); allow delete: if false; }
    // 💵 गल्ला: मालिक + मैनेजर लिखें/पढ़ें; कोई एंट्री बदले/मिटे नहीं
    match /galla/{id} { allow read, create: if mgr(); allow update, delete: if false; }
    // 🧑‍🍳 टीम रजिस्टर: साथी मालिक जोड़े/बदले; तनख्वाह सिर्फ़ मालिक; हाज़िरी और दिया पैसा मालिक + मैनेजर (दिया पैसा बदले/मिटे नहीं)
    match /emp/{id} { allow read: if mgr(); allow create, update: if owner(); allow delete: if false; }
    match /empsal/{id} { allow read, create, update: if owner(); allow delete: if false; }
    match /att/{id} { allow read, create, update: if mgr(); allow delete: if false; }
    match /pay/{id} { allow read, create: if mgr(); allow update, delete: if false; }
    match /cnote/{id} { allow read, create, update: if mgr(); allow delete: if false; }
    // 🚚 177 MH कैंटीन का ऐप "रसोई को दिया" माल यहाँ लिखता है (बिना लॉगिन, सिर्फ़ नया बनाना); पढ़ना/मिलान सिर्फ़ टीम
    match /inbox/{id} {
      allow read, update: if staff();
      allow create: if staff() || (d().src == 'mh177' && d().status == 'new' && d().keys().hasOnly(['src', 'status', 'bill', 'ts', 'by', 'items', 'total'])
        && d().items is list && d().items.size() <= 80 && d().ts is int && d().ts > request.time.toMillis() - 600000 && d().ts < request.time.toMillis() + 600000);
      allow delete: if false;
    }
    // 📒 ग्राहक-बही (v9, 15-11-2026): ऑर्डर पूरा करते समय मैनेजर/डायरेक्टर लिखें; पढ़े सिर्फ़ डायरेक्टर (ग्राहक संस्था के — मैनेजर बदलें तब भी)
    match /cbook/{m} { allow get: if mgr(); allow list: if owner(); allow create, update: if mgr(); allow delete: if false; }
    // 📱 फोन का हाल (v9): हर फोन अपना ही लिखे, डायरेक्टर पढ़े
    match /dev/{uid} { allow create, update: if request.auth != null && request.auth.uid == uid && staff(); allow read: if owner(); allow delete: if false; }
    // 🔐 ग्राहक-खाता (v9): id = sha256("mr|मोबाइल|पासवर्ड") — जो सही मोबाइल+पासवर्ड जाने वही अपना पढ़े; सूची कोई नहीं; लिखे सिर्फ़ डायरेक्टर
    match /cacc/{h} { allow get: if true; allow list: if false; allow create, update: if owner(); allow delete: if false; }
    // ✏️ ग्राहक ने अपना बिल का नाम ठीक किया (v10): ग्राहक सिर्फ़ नया बना सके (छोटा, सिर्फ़ 4 खाने); पढ़े/निपटाए सिर्फ़ डायरेक्टर
    match /cname/{id} { allow create: if d().keys().hasOnly(['m', 'n', 'old', 'ts']) && d().m is string && d().m.size() == 10 && d().n is string && d().n.size() >= 2 && d().n.size() <= 60 && d().old is string && d().old.size() <= 60
        && d().ts is int && d().ts > request.time.toMillis() - 300000 && d().ts < request.time.toMillis() + 300000; allow read, update: if owner(); allow delete: if false; }
    // ⭐ रेटिंग + पसंदीदा डिश (v11): id = sha256("mrf|मोबाइल") — मोबाइल जानने वाला सिर्फ़ यही देखे (नाम/पता/ऑर्डर नहीं); सूची कोई नहीं; लिखे सिर्फ़ डायरेक्टर
    match /cfav/{h} { allow get: if true; allow list: if false; allow create, update: if owner(); allow delete: if false; }
    // 🎙️ वॉकी-टॉकी (v9): टीम बोले/सुने; बदले-मिटे नहीं
    match /talk/{id} { allow read, create: if staff(); allow update, delete: if false; }
    // ⏰ रिमाइंडर का हाल (v9, 15-11-2026): टीम/APK लिखे (हो गया / टाला / छूटा), डायरेक्टर + मैनेजर पढ़ें; बदले-मिटे नहीं
    match /rlog/{id} { allow create: if staff(); allow read: if mgr(); allow update, delete: if false; }
    // 📋 हमारी टीम के काम (v12): डायरेक्टर (VBE मैनेजर ऐप से) लिखे; हर साथी सिर्फ़ वही पढ़े जिसमें em = उसका लॉगिन; मिटे नहीं
    match /tkaam/{id} { allow get, list: if owner() || (request.auth != null && resource.data.em == request.auth.token.email); allow create, update: if owner(); allow delete: if false; }
    // 📋 साथी का जवाब (v12): सिर्फ़ अपने नाम से नया बनाए (हो गया / गया / नहीं + कारण); पढ़े डायरेक्टर; बदले-मिटे नहीं
    match /tkr/{id} { allow create: if request.auth != null && d().em == request.auth.token.email && d().keys().hasOnly(['kid', 'em', 'ans', 'note', 'at', 'by'])
        && d().ans in ['done', 'gaya', 'nahi'] && d().kid is string && d().kid.size() <= 80 && d().at is int && (!('note' in d()) || d().note.size() <= 300);
      allow read: if owner(); allow update, delete: if false; }
    // लोकेशन (APK की TrackService): अपना ही लिखे, सिर्फ़ डायरेक्टर पढ़े
    match /live/{uid} { allow read: if owner(); allow write: if request.auth != null && request.auth.uid == uid && staff(); }
    // लोकेशन के बिंदु (रास्ता): टीम लिखे, मालिक पढ़े
    match /trk/{id} { allow create, update: if staff(); allow read: if owner(); }
  }
}
